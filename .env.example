# Server
PORT=8000
GPU_ID=0

# Trellis
MODEL_ID=microsoft/TRELLIS-text-xlarge
SEED=1
# ATTN_BACKEND can be: flash-attn | xformers (optional)
ATTN_BACKEND=
SPCONV_ALGO=native

# Validator
VALIDATOR_URL=http://localhost:8094/validate_txt_to_3d_ply/
VALIDATION_THRESHOLD=0.65
MAX_ATTEMPTS=3
INNER_DEADLINE_SECONDS=24.0

# Validator HTTP timeouts (s)
VLD_CONNECT_TIMEOUT_S=3.0
VLD_READ_TIMEOUT_S=6.0
VLD_WRITE_TIMEOUT_S=3.0
VLD_POOL_TIMEOUT_S=3.0

# Trellis sampling (kept conservative for the 30s budget)
SPARSE_STEPS=12
SPARSE_CFG=7.5
SLAT_STEPS=12
SLAT_CFG=7.5

# Video
VIDEO_FPS=30
